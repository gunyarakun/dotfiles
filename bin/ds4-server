#!/bin/sh
# Manage the local ds4-server (https://github.com/antirez/ds4).
#
# Usage: ds4-server [run|start|ensure|stop|status|logs]
#   run     start in the foreground (default)
#   start   start in the background and wait until it responds
#   ensure  start in the background only if not already running
#           (prompts on a tty unless DS4_AUTOSTART=1; used by claude-ds4)
#   stop    stop the background server
#   status  report whether the server is responding
#   logs    tail the background server log

DS4_BASE_URL="${DS4_ANTHROPIC_BASE_URL:-http://127.0.0.1:8000}"
DS4_DIR="${DS4_DIR:-$HOME/dev/src/github.com/antirez/ds4}"
# Default flags follow the recommended "local API" setup (long context + disk
# KV checkpoints): see the "Server" section of the ds4 README and the
# "local API" example in `ds4 --help` (ds4_help.c), both of which suggest
# `./ds4-server --ctx 100000 --kv-disk-dir ... --kv-disk-space-mb ...`.
DS4_SERVER_CMD="${DS4_SERVER_CMD:-./ds4-server --ctx 100000 --kv-disk-dir $HOME/.local/share/ds4/kv --kv-disk-space-mb 16384}"
DS4_SERVER_LOG="${DS4_SERVER_LOG:-$HOME/.local/state/ds4-server.log}"
DS4_PID_FILE="${DS4_PID_FILE:-$HOME/.local/state/ds4-server.pid}"
DS4_START_TIMEOUT="${DS4_START_TIMEOUT:-180}"

server_alive() {
    curl -sf --max-time 2 "$DS4_BASE_URL/v1/models" >/dev/null 2>&1
}

require_local() {
    case "$DS4_BASE_URL" in
        *127.0.0.1*|*localhost*) ;;
        *)
            echo "error: $DS4_BASE_URL is a remote host; not starting a local server" >&2
            exit 1
            ;;
    esac
}

start_background() {
    require_local
    mkdir -p "$(dirname "$DS4_SERVER_LOG")" "$(dirname "$DS4_PID_FILE")"
    echo "Starting ds4-server... (log: $DS4_SERVER_LOG)" >&2
    (
        cd "$DS4_DIR" || exit 1
        nohup $DS4_SERVER_CMD >>"$DS4_SERVER_LOG" 2>&1 &
        echo $! >"$DS4_PID_FILE"
    )
    i=0
    while [ "$i" -lt "$DS4_START_TIMEOUT" ]; do
        if server_alive; then
            echo "ds4-server is up" >&2
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    echo "error: ds4-server did not respond within ${DS4_START_TIMEOUT}s; check $DS4_SERVER_LOG" >&2
    return 1
}

case "${1:-run}" in
    run)
        if server_alive; then
            echo "error: ds4-server ($DS4_BASE_URL) is already running" >&2
            exit 1
        fi
        require_local
        cd "$DS4_DIR" || exit 1
        exec $DS4_SERVER_CMD
        ;;
    start)
        if server_alive; then
            echo "ds4-server ($DS4_BASE_URL) is already running" >&2
            exit 0
        fi
        start_background
        ;;
    ensure)
        if server_alive; then
            exit 0
        fi
        require_local
        if [ "${DS4_AUTOSTART:-0}" = "1" ]; then
            start_background
        elif [ -t 0 ]; then
            printf 'ds4-server (%s) is not running. Start it? [Y/n] ' "$DS4_BASE_URL" >&2
            read -r ans
            case "$ans" in
                [Nn]*) echo "Aborted" >&2; exit 1 ;;
                *) start_background ;;
            esac
        else
            echo "error: ds4-server ($DS4_BASE_URL) is not running" >&2
            exit 1
        fi
        ;;
    stop)
        if [ ! -f "$DS4_PID_FILE" ]; then
            echo "error: no pid file ($DS4_PID_FILE); was the server started with 'ds4-server start'?" >&2
            exit 1
        fi
        pid=$(cat "$DS4_PID_FILE")
        if kill "$pid" 2>/dev/null; then
            echo "Stopped ds4-server (pid $pid)" >&2
        else
            echo "error: no process with pid $pid; removing stale pid file" >&2
        fi
        rm -f "$DS4_PID_FILE"
        ;;
    status)
        if server_alive; then
            echo "ds4-server ($DS4_BASE_URL) is running"
        else
            echo "ds4-server ($DS4_BASE_URL) is not responding"
            exit 1
        fi
        ;;
    logs)
        exec tail -f "$DS4_SERVER_LOG"
        ;;
    *)
        echo "usage: ds4-server [run|start|ensure|stop|status|logs]" >&2
        exit 1
        ;;
esac
