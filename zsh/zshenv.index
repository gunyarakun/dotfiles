# zmodload zsh/zprof


# ref.) http://karur4n.hatenablog.com/entry/2016/01/18/100000
setopt no_global_rcs
path+=(
  /usr/local/bin
  /usr/bin
  /bin
  /usr/local/sbin
  /usr/sbin
  /sbin
)
# end

# Homebrew prefix (packages are installed by `mise bootstrap`, with or without Homebrew)
path=(
  /opt/homebrew/bin(N-/)
  /opt/homebrew/sbin(N-/)
  /home/linuxbrew/.linuxbrew/bin(N-/)
  /home/linuxbrew/.linuxbrew/sbin(N-/)
  $path
)

typeset -U path cdpath fpath manpath

# golang
export GOPATH=$HOME/dev
path+=(
  $GOPATH/bin(N-/)
)
