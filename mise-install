#!/bin/zsh
# vim: set expandtab ts=2 sw=2 nowrap ft=sh ff=unix : */
set -e -u

# mise
if [ ! -f ~/.local/bin/mise ]; then
  curl https://mise.run | sh
fi
eval "$(~/.local/bin/mise activate zsh)"
# Update mise itself (herdr etc. require a recent registry)
mise self-update -y || true

mise install python@3.13
mise use --global python@3.13
mise exec python@3.13 -- python -m pip install uv
mise install ruby@3.4
mise use --global ruby@3.4
mise install nodejs@lts
mise use --global nodejs@lts
mise install bun@latest
mise use --global bun@latest
# Install ghq and peco
mise install ghq
mise use --global ghq
mise install peco
mise use --global peco
# Install herdr
mise install herdr
mise use --global herdr
# Install OpenCode
mise install opencode
mise use --global opencode
